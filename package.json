{
  "name": "rollup-plugin-filesize",
  "version": "10.0.0",
  "description": "A rollup plugin to show filesize in the cli",
  "main": "dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "README",
    "!.DS_Store",
    "!.nyc_output"
  ],
  "typings": "./index.d.ts",
  "scripts": {
    "lint": "eslint .",
    "test": "c8 ava --serial test/index.test.js",
    "remove-dist": "rimraf --glob dist/*",
    "pretest": "rollup -c",
    "prepare": "npm run remove-dist && npm run test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritz078/rollup-plugin-filesize.git"
  },
  "keywords": [
    "rollup-plugin"
  ],
  "author": "Ritesh Kumar",
  "contributors": [],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ritz078/rollup-plugin-filesize/issues"
  },
  "homepage": "https://github.com/ritz078/rollup-plugin-filesize#readme",
  "dependencies": {
    "@babel/runtime": "^7.13.8",
    "boxen": "^8.0.1",
    "brotli-size": "4.0.0",
    "colors": "^1.4.0",
    "filesize": "^11.0.24",
    "gzip-size": "^7.0.0",
    "pacote": "^22.0.0",
    "terser": "^5.51.2"
  },
  "devDependencies": {
    "@babel/core": "^7.13.8",
    "@babel/eslint-parser": "^7.13.8",
    "@babel/plugin-syntax-import-assertions": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.13.8",
    "@babel/preset-env": "^7.13.8",
    "@babel/register": "^7.13.8",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-json": "^6.1.0",
    "ava": "^8.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "esm": "^3.2.25",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.3"
  },
  "ava": {
    "workerThreads": false
  }
}
